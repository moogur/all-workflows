#!/usr/bin/env bash

# Git-хук (husky): валидация сообщения коммита.
# Формат и правила — в lib/commit.sh; этот репозиторий дополнительно требует
# префикс задачи ровно GA (lib допускает любой [A-Z][A-Z0-9]*).
# Пример:            [GA-557] feature(frontend): add deploy spa and pwa
# Подключается через "prepare": "husky install" в package.json.

# shellcheck source=lib/commit.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/commit.sh"

# $1 — путь к файлу с текстом коммита (передаёт git). Валидируется только заголовок
# (первая строка): тело коммита — свободный текст.
commit=$(head -1 "$1")

if [[ ! "$commit" =~ $COMMIT_HEADER_REGEX ]]; then
  echo "Header does not match the expected format: [TASK-N] type(scope): subject"
  echo "value = $commit"
  exit 1
fi

task="${BASH_REMATCH[1]}"
type="${BASH_REMATCH[2]}"
scope="${BASH_REMATCH[3]}"
subject="${BASH_REMATCH[4]}"

if [[ "$task" != GA-* ]]; then
  echo "The issue number is not specified correctly"
  echo "value = [$task]"
  exit 1
fi

if ! commit_type_allowed "$type"; then
  echo "Unknown type"
  echo "value = $type"
  exit 1
fi

if ! commit_is_lowercase "$scope"; then
  echo "SCOPE is not lower case"
  echo "value = $scope"
  exit 1
fi

if ! commit_is_lowercase "$subject"; then
  echo "SUBJECT is not lower case"
  echo "value = $subject"
  exit 1
fi

if [[ "${#subject}" -gt "$COMMIT_SUBJECT_MAX_LENGTH" ]]; then
  echo "SUBJECT is longer than the maximum length ($COMMIT_SUBJECT_MAX_LENGTH) - ${#subject}"
  echo "value = $subject"
  exit 1
fi
