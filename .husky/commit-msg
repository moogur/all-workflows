#!/usr/bin/env bash

# Git-хук (husky): валидация сообщения коммита.
# Ожидаемый формат:  [GA-<число>] <type>(<scope>): <subject>
# Пример:            [GA-557] feature(frontend): add deploy spa and pwa
# Правила: type из списка ниже; scope и subject — нижний регистр; subject ≤ 125.
# Подключается через "prepare": "husky install" в package.json.

# check commit message
# - not empty
function checkEmpty() {
  local type="$1"
  local value="$2"

  if [[ -z "$value" ]]; then
    echo "$type is empty"
    exit 1
  fi
}

# - max length
function checkMaxLength() {
  local type="$1"
  local max_length="$2"
  local value="$3"

  if [[ "${#value}" -gt "$max_length" ]]; then
    echo "$type is longer than the maximum length ($max_length) - ${#value}"
    echo "value = $value"
    exit 1
  fi
}

# - is lower case
function checkLowercase() {
  local type="$1"
  local value="$2"
  local value_to_lower_case
  value_to_lower_case=$(echo "$value" | tr '[:upper:]' '[:lower:]')

  if [[ "$value_to_lower_case" != "$value" ]]; then
    echo "$type is not lower case"
    echo "value = $value"
    exit 1
  fi
}

# - include type
# ВНИМАНИЕ: сравнение подстрочное (без якорей) — например, 'feat' пройдёт как
# часть 'feature'. Это зафиксировано в tests/commit-msg.bats как особенность.
function includeInTypes() {
  local value="$1"
  local types_array=(feature bugfix ci config refactor test docs)

  if [[ ! "${types_array[*]}" =~ ${value} ]]; then
    echo "Unknown type"
    echo "value = $value"
    exit 1
  fi
}

# - validate task number
function validateTaskNumber() {
  local value=$1

  local regexp="^\[GA-[0-9]+\]$"
  if [[ ! "$value" =~ $regexp ]]; then
    echo "The issue number is not specified correctly"
    echo "value = $value"
    exit 1
  fi
}

# variables
# $1 — путь к файлу с текстом коммита (передаёт git). Разбираем на части только
# заголовок: awk работает построчно, и на многострочном сообщении в проверку
# уходила склейка первых слов всех строк.
commit=$(head -1 "$1")
task_number=$(echo "$commit" | awk -F' ' '{print $1}')                  # первый токен: [GA-123]
type=$(echo "$commit" | awk -F'] ' '{print $2}' | awk -F'(' '{print $1}')  # между "] " и "("
scope=$(echo "$commit" | awk -F'(' '{print $2}' | awk -F')' '{print $1}')  # между "(" и ")"
message=$(echo "$commit" | awk -F': ' '{print $2}')                     # после первого ": "

# checking
## TASK NUMBER
validateTaskNumber "$task_number"

## TYPE
checkEmpty "TYPE" "$type"
includeInTypes "$type"

## SCOPE
checkEmpty "SCOPE" "$scope"
checkLowercase "SCOPE" "$scope"

## SUBJECT
checkEmpty "SUBJECT" "$message"
checkLowercase "SUBJECT" "$message"
checkMaxLength "SUBJECT" 125 "$message"
